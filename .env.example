# Operator sign-in -- generate all three with: npm run hash-password -- 'a long passphrase'
OPERATOR_PASSWORD_HASH=
SESSION_SECRET=
# Optional but recommended: base32 secret for an authenticator app (6-digit codes)
OPERATOR_TOTP_SECRET=

# One entry per school. `secret` must equal that school's PLATFORM_SECRET env var.
# SCHOOLS_JSON=[{"slug":"greenfield","name":"Greenfield Academy","baseUrl":"https://greenfield.example.com","secret":"<32+ random chars>"}]
SCHOOLS_JSON=
